{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "app": {
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1234",
    "frontendDist": "https://proxygram.azhuleev.ru",
    "removeUnusedCommands": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "proxygram"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyMDMxQzk2REQwQjhEMDMKUldRRGpRdmRsaHdEa3BuYXNDcmxCVG9CRjdoeDkyNGVtOHdGOW82MnJwbDB0TG8zVy9NSytDazUK",
      "endpoints": [
        "https://proxygram.azhuleev.ru/downloads/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "copyright": "Proxygram",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Неофициальный клиент на Telegram API: архив сообщений и общий доступ к чатам",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "Неофициальный клиент на Telegram API: архив сообщений и общий доступ к чатам",
    "targets": [
      "app",
      "nsis",
      "appimage"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "identifier": "app.proxygram.client",
  "productName": "Proxygram",
  "version": "1.0.3"
}
